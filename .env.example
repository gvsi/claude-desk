# Local settings. Copy this file to .env (git-ignored) before running anything.
# Every value here is a placeholder for the local Docker database, not a real secret.
# Keep each role's password the same in its *_ROLE_PASSWORD and *_DATABASE_URL lines.

# desk_admin, the Postgres superuser in docker-compose.yml; migrations run as it.
DESK_ADMIN_PASSWORD=change-me-admin
ADMIN_DATABASE_URL=postgresql+psycopg://desk_admin:change-me-admin@localhost:5433/desk

# Role passwords that `make db-roles` sets. Migration 0001_core creates the roles without login.
KERNEL_ROLE_PASSWORD=change-me-kernel
API_ROLE_PASSWORD=change-me-api
MOCKPAY_ROLE_PASSWORD=change-me-mockpay

# What each process connects with.
KERNEL_DATABASE_URL=postgresql+psycopg://desk_kernel:change-me-kernel@localhost:5433/desk
API_DATABASE_URL=postgresql+psycopg://desk_api:change-me-api@localhost:5433/desk
MOCKPAY_DATABASE_URL=postgresql+psycopg://desk_mockpay:change-me-mockpay@localhost:5433/desk
