{
  "name": "claude-desk-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "check:build": "node scripts/check-build.mjs",
    "e2e:mock": "playwright test --project mock",
    "e2e:live": "playwright test --project live",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:screens": "vitest run --project screens",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "gen:mark": "node scripts/gen-mark.mjs",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "check:ds": "vitest run --project unit src/ds/guards.test.ts && vitest run --project ds-browser && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4",
    "rehype-harden": "1.1.8",
    "rehype-sanitize": "6.0.0",
    "streamdown": "2.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.4",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "msw": "3.0.3",
    "playwright": "1.64.0",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vitest-browser-react": "2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "mock-public"
    ]
  }
}
