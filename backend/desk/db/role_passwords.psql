-- Let each process role log in with its password. `make db-roles` runs this as desk_admin.
-- Passwords come from the environment into psql variables (\getenv), so they never appear on
-- a command line, in output or in psql history. Roles that don't exist yet (before migration
-- 0001_core) are skipped.
\set ON_ERROR_STOP on
\set QUIET on
\getenv kernel_password KERNEL_ROLE_PASSWORD
\getenv api_password API_ROLE_PASSWORD
\getenv mockpay_password MOCKPAY_ROLE_PASSWORD

SELECT
    EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'desk_kernel') AS has_kernel,
    EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'desk_api') AS has_api,
    EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'desk_mockpay') AS has_mockpay
\gset

\if :has_kernel
ALTER ROLE desk_kernel WITH LOGIN PASSWORD :'kernel_password';
\else
\echo 'db-roles: desk_kernel does not exist yet; run the migrations first'
\endif
\if :has_api
ALTER ROLE desk_api WITH LOGIN PASSWORD :'api_password';
\else
\echo 'db-roles: desk_api does not exist yet; run the migrations first'
\endif
\if :has_mockpay
ALTER ROLE desk_mockpay WITH LOGIN PASSWORD :'mockpay_password';
\else
\echo 'db-roles: desk_mockpay does not exist yet; run the migrations first'
\endif
