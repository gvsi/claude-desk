{
  "openapi": "3.1.0",
  "info": {
    "title": "Claude Desk API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "The kernel's health, for the load balancer and the smoke checks; no cookie is read.",
        "operationId": "system_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/owner/copies": {
      "post": {
        "summary": "Create Copy",
        "description": "A fresh copy of the Rivera seed for whoever holds the passcode, and the owner cookie for it.",
        "operationId": "owner_create_copy",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CopyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CopyOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/owner/start_over": {
      "post": {
        "summary": "Start Over",
        "description": "A fresh copy for an owner who already has one; the old copy is left as it is, and the cookie moves on.",
        "operationId": "owner_start_over",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CopyOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/owner/me": {
      "get": {
        "summary": "Me",
        "description": "The copy the owner cookie names.",
        "operationId": "owner_me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CopyOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/{slug}": {
      "get": {
        "summary": "Public Desk",
        "description": "The Desk's public page: the kernel's `PublicDesk`, unchanged. Never cached: the page's open status refetches\non a delay that assumes a fresh answer (CloudFront doesn't cache `/api/*` either).",
        "operationId": "public_public_desk",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 35,
                  "pattern": "^[A-Za-z0-9-]+$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lang"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicDesk"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/public/desks/{slug}/agent_card": {
      "get": {
        "summary": "Agent Card",
        "description": "Where agents send their requests and how they sign them, built by code from `PUBLIC_ORIGIN`, never from the\nrequest's own host headers. The kernel's public Desk is read only to answer 404 for an unknown slug.",
        "operationId": "public_agent_card",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCardOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/public/desks/{slug}/sessions": {
      "post": {
        "summary": "Open Session",
        "description": "The visitor's session on the slug's Desk: the one the cookie holds while the kernel says it is open there (a\nreturning visitor, ledgered as a `session` event), else a new one, whose token only the cookie holds.",
        "operationId": "public_open_session",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitorSession"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/public/desks/{slug}/session": {
      "get": {
        "summary": "Visitor Session",
        "description": "The session's state and its transcript as the visitor sees it: their own words and what was delivered to\nthem, never model, note, owner-only or other sessions' rows. `last_seq` is read in the same snapshot, so the\nevent stream opened after it neither misses nor repeats an item.",
        "operationId": "public_visitor_session",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitorTranscript"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/public/desks/{slug}/messages": {
      "post": {
        "summary": "Send Message",
        "description": "Store the visitor's message and start Claude's turn; the answer arrives on the event stream.\n\nWithin the message limits (per session and per copy), what control rows left for this session is done first,\nso an outcome that came in meanwhile precedes the message and the same turn answers both. The message wakes a\nturn only while the session is Claude's (mode `ai`): during a take-over the owner answers it, and a paused\nsession answers at once with the kernel's handoff, with no model call.",
        "operationId": "public_send_message",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageIn"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageAccepted"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/public/desks/{slug}/events": {
      "get": {
        "summary": "Events",
        "description": "The session's events after the cursor, then live ones (SSE `id` is the event's `seq`). On opening, and as each\ncontrol row appears while it is open, the session's runner does what control rows left and runs waiting work,\nwith the visitor's credential, in a task of its own: a hang-up never cuts it short. Three streams per session\nand thirty per address may be open at once.",
        "operationId": "public_events",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The session's events",
            "content": {
              "text/event-stream": {}
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/public/desks/{slug}/decisions/{decision_id}/cancel": {
      "post": {
        "summary": "Cancel Request",
        "description": "Withdraw one of the visitor's own held requests. The kernel cancels it (409 once it is no longer held, 404\nfor another session's); its signed outcome is then shown as `resolved`, and Claude reads it at the next turn\n(an `action_update` that starts none: the visitor already sees what happened).",
        "operationId": "public_cancel_request",
        "parameters": [
          {
            "name": "decision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "title": "Decision Id"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelAccepted"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentCardOut": {
        "properties": {
          "endpoint": {
            "type": "string",
            "title": "Endpoint"
          },
          "signing": {
            "$ref": "#/components/schemas/AgentCardSigning"
          },
          "example_request": {
            "type": "string",
            "title": "Example Request"
          }
        },
        "type": "object",
        "required": [
          "endpoint",
          "signing",
          "example_request"
        ],
        "title": "AgentCardOut",
        "description": "`GET /api/public/desks/{slug}/agent_card`: built by code from `PUBLIC_ORIGIN` and the slug, with no model\ntext; what agents may do here, and the AI disclosure, are the kernel's `PublicDesk.agent_card`."
      },
      "AgentCardSigning": {
        "properties": {
          "headers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Headers"
          },
          "payload_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Payload Fields"
          },
          "canonical": {
            "type": "string",
            "const": "RFC 8785",
            "title": "Canonical"
          },
          "algorithm": {
            "type": "string",
            "const": "Ed25519",
            "title": "Algorithm"
          },
          "encoding": {
            "type": "string",
            "const": "lowercase hex",
            "title": "Encoding"
          },
          "ts_window_s": {
            "type": "integer",
            "title": "Ts Window S"
          }
        },
        "type": "object",
        "required": [
          "headers",
          "payload_fields",
          "canonical",
          "algorithm",
          "encoding",
          "ts_window_s"
        ],
        "title": "AgentCardSigning",
        "description": "How an agent signs each request: the headers it sends and the payload its Ed25519 signature covers."
      },
      "ApiError": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "retry_after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ApiError",
        "description": "Every error answer: `error` names what went wrong; `code` is the kernel's, when `error` is \"kernel\";\n`retry_after` is the seconds to wait, on a 429. Fields that don't apply are left out."
      },
      "CancelAccepted": {
        "properties": {
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          }
        },
        "type": "object",
        "required": [
          "decision_id"
        ],
        "title": "CancelAccepted",
        "description": "202: the held request is withdrawn; its outcome arrives on the event stream as `resolved`."
      },
      "CardOption": {
        "properties": {
          "option_id": {
            "type": "string",
            "title": "Option Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "option_id",
          "label"
        ],
        "title": "CardOption"
      },
      "CopyOut": {
        "properties": {
          "copy_id": {
            "type": "string",
            "title": "Copy Id"
          },
          "desks": {
            "items": {
              "$ref": "#/components/schemas/DeskSummary"
            },
            "type": "array",
            "title": "Desks"
          }
        },
        "type": "object",
        "required": [
          "copy_id",
          "desks"
        ],
        "title": "CopyOut",
        "description": "The owner's copy: what `POST /api/owner/copies`, `start_over` and `me` answer with."
      },
      "CopyRequest": {
        "properties": {
          "passcode": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Passcode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "passcode"
        ],
        "title": "CopyRequest"
      },
      "DeskSummary": {
        "properties": {
          "desk_id": {
            "type": "string",
            "title": "Desk Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "business_name": {
            "type": "string",
            "title": "Business Name"
          },
          "hours": {
            "items": {
              "$ref": "#/components/schemas/HoursWindow"
            },
            "type": "array",
            "title": "Hours"
          },
          "answering": {
            "type": "boolean",
            "title": "Answering"
          }
        },
        "type": "object",
        "required": [
          "desk_id",
          "slug",
          "name",
          "business_name",
          "hours",
          "answering"
        ],
        "title": "DeskSummary"
      },
      "EvHeld": {
        "properties": {
          "type": {
            "type": "string",
            "const": "held",
            "title": "Type"
          },
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "allowed",
              "held",
              "refused",
              "approved",
              "denied",
              "expired",
              "cancelled",
              "executed",
              "failed",
              "unknown",
              "refused_at_execution"
            ],
            "title": "State"
          },
          "visitor_plain": {
            "type": "string",
            "title": "Visitor Plain"
          },
          "ledger_seq": {
            "type": "integer",
            "title": "Ledger Seq"
          },
          "signature": {
            "type": "string",
            "title": "Signature"
          }
        },
        "type": "object",
        "required": [
          "type",
          "decision_id",
          "state",
          "visitor_plain",
          "ledger_seq",
          "signature"
        ],
        "title": "EvHeld"
      },
      "EvMessage": {
        "properties": {
          "type": {
            "type": "string",
            "const": "message",
            "title": "Type"
          },
