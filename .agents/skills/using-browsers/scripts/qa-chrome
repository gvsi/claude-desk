#!/usr/bin/env python3
"""The QA Chrome: a separate Chrome that agents drive, never a person's own browser.

It has its own profile (QA_CHROME_PROFILE), its own sign-ins and its own
debugging port (QA_CHROME_PORT), so agents attach without an Allow prompt,
unattended runs work, and a person's own browser never needs a debugging port.

    .agents/skills/using-browsers/scripts/qa-chrome up       # start it (or confirm it's running)
    .agents/skills/using-browsers/scripts/qa-chrome status
    .agents/skills/using-browsers/scripts/qa-chrome down     # shut it; sign-ins stay in the profile

Agents attach with `agent-browser --cdp <port> --pin-tab`, the port `status` prints.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

HOST = "127.0.0.1"
# One above Chrome's usual debugging port, 9222; set QA_CHROME_PORT to choose another. up() refuses a port another
# process holds.
PORT = int(os.environ.get("QA_CHROME_PORT", "9223"))
PROFILE = Path(os.environ.get("QA_CHROME_PROFILE", Path.home() / ".qa-chrome")).expanduser()
CHROME = os.environ.get("QA_CHROME_BINARY", "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")


def cdp(path: str):
    req = urllib.request.Request(f"http://{HOST}:{PORT}{path}")
    with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=3) as resp:
        return json.loads(resp.read() or b"null")


def main_pids() -> list[int]:
    """Chrome browser processes (not helpers) started with exactly this profile."""
    out = subprocess.run(["ps", "-axww", "-o", "pid=,command="], capture_output=True, text=True).stdout
    flag = re.compile(r"(?:^|\s)" + re.escape(f"--user-data-dir={PROFILE}") + r"(?=\s|$)")
    pids = []
    for line in out.splitlines():
        pid, _, cmd = line.strip().partition(" ")
        if cmd.startswith(CHROME) and "--type=" not in cmd and flag.search(cmd):
            pids.append(int(pid))
    return pids


def listener_is_ours() -> bool | None:
    """True if only our Chrome listens on PORT, False if something else does, None if nothing listens."""
    out = subprocess.run(["lsof", "-nP", f"-iTCP:{PORT}", "-sTCP:LISTEN", "-Fp"], capture_output=True, text=True).stdout
    pids = {int(x[1:]) for x in out.splitlines() if x.startswith("p")}
    if not pids:
        return None
    return pids <= set(main_pids())


def status() -> dict:
    owner = listener_is_ours()
    if owner is False:
        return {"running": False, "port": PORT, "error": "port taken by another process"}
    if owner is None:
        return {"running": False, "port": PORT, "profile": str(PROFILE)}
    try:
        browser = cdp("/json/version").get("Browser")
    except OSError:
        return {"running": False, "port": PORT, "error": "Chrome is up but its debugging port doesn't answer"}
    return {"running": True, "port": PORT, "browser": browser, "profile": str(PROFILE)}


def up() -> dict:
    now = status()
    if now["running"] or "error" in now:
        return now
    PROFILE.mkdir(parents=True, exist_ok=True)
    subprocess.Popen(
        [CHROME, f"--user-data-dir={PROFILE}", f"--remote-debugging-port={PORT}",
         f"--remote-debugging-address={HOST}", "--no-first-run", "--no-default-browser-check",
         "--disable-sync", "--mute-audio", "--disable-background-timer-throttling",
         "--disable-backgrounding-occluded-windows", "--disable-renderer-backgrounding"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(40):
        time.sleep(0.5)
        now = status()
        if now["running"]:
            return {**now, "started": True}
    return {**now, "error": now.get("error", "didn't come up in 20 s")}


def down() -> dict:
    pids = main_pids()
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    for _ in range(20):
        if not main_pids():
            break
        time.sleep(0.5)
    return {**status(), "stopped": pids}


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("action", choices=("up", "down", "status"))
    out = {"up": up, "down": down, "status": status}[ap.parse_args().action]()
    print(json.dumps(out, indent=1))
    return 0 if "error" not in out else 1


if __name__ == "__main__":
    sys.exit(main())
